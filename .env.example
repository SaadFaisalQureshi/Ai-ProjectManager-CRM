# Database (PostgreSQL). Supabase: pooled URL (port 6543, ?pgbouncer=true) here...
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# ...and the direct URL (port 5432) here, used by Prisma for schema changes.
# Local PostgreSQL: use the same URL for both.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Signs the session cookie. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# AI (server only, never prefix with NEXT_PUBLIC_)
LLM_PROVIDER="anthropic"
LLM_API_KEY="your-anthropic-api-key"
LLM_MODEL="your-model-name"
LLM_TIMEOUT_MS="60000"
